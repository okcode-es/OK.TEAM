# ==============================================================================
# okTeam Environment Template (Phase 1)
# Copy to .env for local development. NEVER commit real secrets.
# ==============================================================================

# --- App ---
APP_ENV=development
APP_NAME=okTeam API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Local Dev Auth Helper (MUST remain false in production) ---
# Only active when APP_ENV=development AND DEV_AUTH_ENABLED=true AND SUPABASE_JWT_SECRET is set.
DEV_AUTH_ENABLED=false

# --- Database (EU Supabase PostgreSQL or local-db profile - Async SQLAlchemy URL) ---
# Local Docker Postgres: postgresql+asyncpg://postgres:okteam_dev_password@localhost:5433/okteam
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/okteam

# --- Supabase Auth (JWT Verification ONLY on Backend; Auth ONLY on Frontend) ---
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Prefer JWKS (ES256/RS256) via SUPABASE_URL/auth/v1/.well-known/jwks.json.
# Optional HS256 secret (also required when DEV_AUTH_ENABLED=true for local dev tokens):
SUPABASE_JWT_SECRET=
# Service role key is strictly backend-only (for signed private storage URLs >= Phase 4)
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_BACKEND_ONLY

# --- Field-Level Encryption (NIE / IBAN / NAF — Phase 2+) ---
# 32-byte base64url key for AES-256-GCM (generate locally, never hardcode)
PII_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# --- Frontend (Vite public vars — ONLY URL & Anon Key for Supabase Auth) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://CHANGE_ME.supabase.co
VITE_SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY
VITE_DEV_AUTH_ENABLED=false
